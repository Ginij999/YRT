# MONGODB_URI: MongoDB Atlas connection string. If omitted, runs with local persistent store in /data/cms-db.json.
MONGODB_URI=""

# CLOUDINARY_URL / Credentials: Optional Cloudinary cloud media storage.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
